# ─────────────────────────────────────────────────────────────────────────
# Learning Academy — environment template.
# Copy to apps/api/.env (API) and apps/web/.env.local (web). Never commit
# real values. Variables marked [prod] have development fallbacks but are
# REQUIRED in production (the API refuses to boot without them).
# ─────────────────────────────────────────────────────────────────────────

# ── API: core ────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# PostgreSQL connection (docker-compose.yml provides this locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy?schema=public
# Dedicated database for the integration tests (name must end in _test).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy_test?schema=public
# Public URL of the web app (used in emails and payment callbacks). [prod]
WEB_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly with credentials.
CORS_ORIGINS=http://localhost:3000
# Set to true when the API runs behind a reverse proxy / load balancer.
TRUST_PROXY=false
# json (default) or pretty
LOG_FORMAT=json

# ── API: authentication ──────────────────────────────────────────────────
# At least 32 random characters in production: openssl rand -base64 48  [prod]
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14
# Cookies: secure defaults to true in production. Set COOKIE_DOMAIN only if
# the web app and API are served from different subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Requests per minute per client for ordinary endpoints (auth endpoints have stricter limits).
RATE_LIMIT_PER_MINUTE=300

# ── API: payments ────────────────────────────────────────────────────────
# sandbox (local development only — refused in production) or paystack
PAYMENT_PROVIDER=sandbox
# Paystack secret key (sk_test_… or sk_live_…). Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where the provider returns the learner after checkout. Defaults to ${WEB_URL}/checkout/callback
PAYMENT_CALLBACK_URL=
# Webhook URL to register in the Paystack dashboard: https://<web-or-api-host>/api/v1/payments/webhook

# ── API: media storage ───────────────────────────────────────────────────
STORAGE_LOCAL_ROOT=storage/uploads
MEDIA_PUBLIC_BASE_URL=/api/v1/media/public
MAX_UPLOAD_BYTES=5242880

# ── API: email ───────────────────────────────────────────────────────────
# outbox: write emails as JSON files to MAIL_OUTBOX_DIR (development).
# disabled: drop emails. A real provider must be added before launch (see README).
MAIL_TRANSPORT=outbox
MAIL_FROM=Cnergy Academy <no-reply@academy.local>
MAIL_OUTBOX_DIR=storage/outbox

# ── Web (apps/web/.env.local) ────────────────────────────────────────────
# Where the Next.js server reaches the API. Read at BUILD time for the
# /api/v1 rewrite and at runtime for server-rendered pages.
API_INTERNAL_URL=http://localhost:4000
